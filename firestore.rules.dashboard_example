rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // تحقق أساسي مطابق للمشروع الأصلي — يمنع البيانات العشوائية
    function isRsvpBaseValid() {
      return request.resource.data.keys().hasAll([
        'eventId','guestId','guestName','attendanceStatus','guestCount','message','language','deviceId','createdAt'
      ])
      && request.resource.data.keys().hasOnly([
        'eventId','guestId','guestName','attendanceStatus','guestCount','message','language','deviceId','createdAt','updatedAt',
        'notificationsEnabled','fcmToken','reminderSchedule','notificationsUpdatedAt','phone','phoneNumber'
      ])
      && request.resource.data.eventId is string
      && request.resource.data.guestId is string
      && request.resource.data.guestName is string
      && request.resource.data.attendanceStatus in ['attending','declined','pending']
      && request.resource.data.guestCount is int
      && request.resource.data.message is string
      && request.resource.data.language is string
      && request.resource.data.deviceId is string
      && (
           (request.resource.data.attendanceStatus=='attending' && request.resource.data.guestCount>=1 && request.resource.data.guestCount<=5)
        || (request.resource.data.attendanceStatus=='declined' && request.resource.data.guestCount==0)
        || (request.resource.data.attendanceStatus=='pending' && request.resource.data.guestCount==0)
      );
    }

    // للسماح لتطبيق العريس (Wedding Dashboard) بدون Login — كما طُلب
    // القراءة مفتوحة، الكتابة ما زالت محمية بـ isRsvpBaseValid
    // إذا أردت حماية لاحقاً بدون شاشة Login: استبدل 'if true' بـ 'if request.auth != null' وأضف signInAnonymously() في التطبيق
    match /guestResponses/{responseId} {
      allow list, get: if true;
      allow create, update: if isRsvpBaseValid();
      allow delete: if false;
    }

    match /comments/{commentId} {
      allow create: if request.resource.data.keys().hasOnly(['name','message','siteId','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.message is string;
      allow read, update, delete: if false;
    }
  }
}
